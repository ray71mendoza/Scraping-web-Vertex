# ═══════════════════════════════════════════════════════════════
# VERTEX PROSPECT — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://vertex:vertex_secret@localhost:5432/vertex_prospect?schema=public

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Google Places API (New) ───────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACES_CACHE_TTL_SECONDS=2592000

# ── OpenAI / Anthropic ────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ── Email (Resend / SendGrid) ────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@vertex.com

# ── WhatsApp Business API ────────────────────────────────────
# WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ── Scraping ──────────────────────────────────────────────────
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MAX_RETRIES=2
# PROXY_LIST=http://proxy1:port,http://proxy2:port

# ── BullMQ Workers ───────────────────────────────────────────
DISCOVERY_QUEUE_CONCURRENCY=5
ENRICHMENT_QUEUE_CONCURRENCY=3
