# ═══════════════════════════════════════════════════════════════
# VERTEX PROSPECT — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and configure real credentials.
# All secrets remain server-side. Do NOT expose in client code.
# ═══════════════════════════════════════════════════════════════

# ── App & Runtime ─────────────────────────────────────────────
NODE_ENV=production
APP_PORT=4000
WEB_PORT=3000
APP_URL=https://api.vertexcorp.com.co
WEB_URL=https://scraping-web-vertex.rmendozaat.workers.dev

# ── PostgreSQL (Neon / Supabase / Self-hosted) ─────────────────
DATABASE_URL=postgresql://user:password@ep-cool-vertex-123456.us-east-2.aws.neon.tech/vertex_prospect?sslmode=require

# ── Redis / BullMQ (Upstash / Redis Cloud) ─────────────────────
REDIS_URL=rediss://default:password@vertex-redis.upstash.io:6379
REDIS_HOST=vertex-redis.upstash.io
REDIS_PORT=6379

# ── Google Places API (Places New) ────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaSyPlaceholderGooglePlacesApiKey
GOOGLE_PLACES_CACHE_TTL_SECONDS=2592000

# ── LLM Engine (OpenAI / Anthropic) ───────────────────────────
OPENAI_API_KEY=sk-proj-placeholderOpenAiApiKey
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-placeholderAnthropicKey

# ── Authentication & Security ─────────────────────────────────
JWT_SECRET=production_random_64_character_hex_jwt_secret_key
JWT_EXPIRES_IN=7d

# ── Resend Email Integration ──────────────────────────────────
# Required for live direct in-app email dispatch
RESEND_API_KEY=re_placeholder_resend_api_key
EMAIL_FROM=VERTEX Consultoría <contacto@vertexcorp.com.co>
RESEND_WEBHOOK_SECRET=whsec_placeholder_resend_signing_secret

# ── Meta WhatsApp Business Platform Cloud API ─────────────────
# Required for live direct in-app WhatsApp messaging
WHATSAPP_API_TOKEN=EAAKplaceholderMetaAccessToken
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_ACCOUNT_ID=982736451029384
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vertex_meta_verify_token_prod
WHATSAPP_APP_SECRET=placeholder_meta_app_secret
WHATSAPP_TEMPLATE_PROSPECT=vertex_prospect_introduction_v1

# ── Storage & Artifacts (Cloudflare R2 / S3) ───────────────────
R2_ACCOUNT_ID=placeholder_cloudflare_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=vertex-audit-artifacts

# ── Bounded Crawler & Audit Engine ────────────────────────────
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_PAGES_PER_AUDIT=3
EVIDENCE_COVERAGE_GATE=0.40

# ── Queue Concurrency ─────────────────────────────────────────
DISCOVERY_QUEUE_CONCURRENCY=5
ENRICHMENT_QUEUE_CONCURRENCY=3
OUTREACH_QUEUE_CONCURRENCY=5
